{
  "servers": {
    "qgis": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "<ruta de trabajo>/qgis_mcp/src/qgis_mcp",
        "run",
        "qgis_mcp_server.py"
      ],
      "env": {
        "QGIS_MCP_HOST": "127.0.0.1",
        "QGIS_MCP_PORT": "9876"
      }
    }
  }
}
