{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pytest: todo",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "tests"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "pytest: fichero actual",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Guion actual",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Adjuntar a QGIS (debugvs / ptvsd)",
      "// como": "En la consola de QGIS: import debugpy; debugpy.listen(5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/src/geomorphic_reclamation_designer",
          "remoteRoot": "${env:APPDATA}/QGIS/QGIS4/profiles/default/python/plugins/geomorphic_reclamation_designer"
        }
      ],
      "justMyCode": false
    }
  ]
}
